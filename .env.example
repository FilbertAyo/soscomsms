APP_NAME="Soscom SMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Africa/Dar_es_Salaam

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=300

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.soscom.co.tz
MAIL_PORT=587
MAIL_USERNAME=sms@soscom.co.tz
MAIL_PASSWORD=
# Set MAIL_PASSWORD to the sms@soscom.co.tz mailbox password.
MAIL_FROM_ADDRESS="sms@soscom.co.tz"
MAIL_FROM_NAME="Soscom SMS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,::1
# Production: SANCTUM_STATEFUL_DOMAINS=sms.soscom.co.tz
# Production: SESSION_SECURE_COOKIE=true

AUTH_OTP_EXPIRE=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_SKIP_AFTER_LOGOUT_MINUTES=120

SMS_GATEWAY=fake
# Production only, after Mobishastra has whitelisted the SOSCOM static IP:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://sms.soscom.co.tz
# TRUSTED_PROXIES=*
# LOG_CHANNEL=stack
# LOG_STACK=daily
# LOG_DAILY_DAYS=14
# DB_CONNECTION=mysql
# QUEUE_CONNECTION=database
# MAIL_MAILER=smtp
# MAIL_FROM_ADDRESS="sms@soscom.co.tz"
# SMS_GATEWAY=mobishastra
SMS_PROVIDER_PROFILE_ID=SOSCOM
SMS_PROVIDER_PASSWORD=
SMS_PROVIDER_BASE_URL=https://mshastra.com
SMS_PROVIDER_STATIC_IP=
SMS_PROVIDER_COUNTRY_CODE=ALL
SMS_PROVIDER_LOW_BALANCE=10000
SMS_BACKUP_KEEP_DAYS=14
SMS_LOW_BALANCE_ALERT_HOURS=12
SMS_PROVIDER_DLR_PATH=dlrstatus_api.aspx
SMS_PROVIDER_DLR_TOKEN=
SMS_FAKE_BALANCE=100000
SMS_FAKE_AUTO_DLR=true
SMS_API_RATE_LIMIT=60
SMS_DASHBOARD_SEND_RATE_LIMIT=30
SMS_API_MAX_KEYS=10
SMS_LIPA_NAMBA=123456
SMS_LIPA_NAMBA_NAME="SOSCOM TECHNOLOGIES COMPANY LIMITED"
