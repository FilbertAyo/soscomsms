APP_NAME="Soscom SMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sms.soscom.co.tz
APP_TIMEZONE=Africa/Dar_es_Salaam

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=300

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.soscom.co.tz
MAIL_PORT=587
MAIL_USERNAME=sms@soscom.co.tz
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="sms@soscom.co.tz"
MAIL_FROM_NAME="Soscom SMS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=sms.soscom.co.tz
TRUSTED_PROXIES=*

SMS_GATEWAY=mobishastra
SMS_PROVIDER_PROFILE_ID=SOSCOM
SMS_PROVIDER_PASSWORD=
SMS_PROVIDER_BASE_URL=https://mshastra.com
SMS_PROVIDER_STATIC_IP=
SMS_PROVIDER_COUNTRY_CODE=ALL
SMS_PROVIDER_LOW_BALANCE=10000
SMS_BACKUP_KEEP_DAYS=14
SMS_LOW_BALANCE_ALERT_HOURS=12
SMS_PROVIDER_DLR_PATH=dlrstatus_api.aspx
SMS_PROVIDER_DLR_TOKEN=
SMS_FAKE_BALANCE=0
SMS_FAKE_AUTO_DLR=false
SMS_API_RATE_LIMIT=60
SMS_DASHBOARD_SEND_RATE_LIMIT=30
SMS_API_MAX_KEYS=10
SMS_LIPA_NAMBA=
SMS_LIPA_NAMBA_NAME="SOSCOM TECHNOLOGIES COMPANY LIMITED"
